{
    "name": "thephpcc/eventflow",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Thephpcc\\EventFlow\\": "src/"
        }
    },
    "prefer-stable": true,
    "require": {
        "php": ">=8.5.7"
    },
    "scripts": {
        "ci": [
            "@coding-standard",
            "@static-analysis",
            "@architecture",
            "@tests",
            "@mutation-testing"
        ],
        "refactoring": [
            "@php tools/rector",
            "@php tools/php-cs-fixer fix"
        ],
        "coding-standard": "@php tools/php-cs-fixer fix --dry-run --diff",
        "static-analysis": "@php tools/phpstan analyse",
        "architecture": "@php tools/deptrac analyse --no-progress",
        "tests": "@php tools/phpunit --compact",
        "mutation-testing": "@php tools/infection"
    },
    "scripts-descriptions": {
        "ci": "Runs the complete quality gate (the same checks the CI pipeline runs)",
        "refactoring": "Refactors the code with Rector and then fixes the coding standard with PHP CS Fixer",
        "coding-standard": "Checks the coding standard with PHP CS Fixer",
        "static-analysis": "Runs static analysis with PHPStan",
        "architecture": "Verifies the architecture rules with Deptrac",
        "tests": "Runs the test suite with PHPUnit",
        "mutation-testing": "Runs mutation testing with Infection"
    },
    "config": {
        "platform": {
            "php": "8.5.7"
        },
        "policy": {
            "malware": {
                "audit": "fail"
            },
            "security-advisory": {
                "audit": "fail"
            },
            "abandoned": {
                "audit": "fail"
            }
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
